---
import CamelLogo from '../../assets/logo/sina-camel-logo.svg';
---

<div class="intro">
  {/* viewBox crops the traced 447×447 canvas down to the camel's measured bounds. */}
  <CamelLogo
    class="intro-logo"
    viewBox="79 101 289 246"
    width="289"
    height="246"
    aria-hidden="true"
    focusable="false"
  />
  <canvas class="intro-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { startIntro } from '../../features/intro';

  startIntro();
</script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background-color: var(--color-cream);
  }

  .intro :global(.intro-logo) {
    width: min(80vw, 80vh, 640px);
    height: auto;
    color: var(--color-rust);
    opacity: 0.2;
  }

  .intro :global(.intro-logo g) {
    fill: currentColor;
  }

  .intro-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(body:has(.intro)) {
    overflow: hidden;
  }
</style>
