---
---

<section class="hero" id="top" data-hero>
  <div class="hero__card">
    <div class="hero__background" aria-hidden="true" data-hero-background></div>
    <div class="hero__content" data-hero-content>
      <h1 class="hero__title">SINA</h1>
      <p class="hero__tagline">an oasis in the heart of amman, blending comfort and nature.</p>
      <div class="hero__meta">
        <div class="hero__details">
          <p>amman · <time data-hero-clock>--:--</time></p>
          <p>specialty coffee</p>
        </div>
        <a class="hero__scroll-cue" href="#about">
          <span class="hero__scroll-line" aria-hidden="true"></span>
          scroll
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../features/hero';
</script>

<style>
  .hero {
    height: 100svh;
    padding: var(--space-gap);
  }

  .hero__card {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    color: var(--color-cream);
  }

  .hero__background {
    position: absolute;
    inset: -10% 0 0 0;
    background: radial-gradient(
      ellipse at 50% 85%,
      var(--color-kraft) 0 14%,
      var(--color-wood) 30%,
      var(--color-rust) 50%,
      var(--color-espresso) 85%
    );
    will-change: transform;
  }

  .hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-inset);
    padding: var(--space-inset);
    will-change: transform, opacity;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(110px, 22vw, 320px);
    font-weight: 400;
    line-height: 0.8;
    letter-spacing: 0.08em;
    text-align: center;
  }

  .hero__tagline {
    max-width: 30ch;
    margin: 0 auto;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.1;
    text-align: center;
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .hero__details p {
    margin: 0;
  }

  .hero__details p + p {
    margin-block-start: 6px;
  }

  .hero__scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
  }

  .hero__scroll-line {
    width: 1px;
    height: 36px;
    background: currentColor;
    transform-origin: top;
    animation: hero-drip 1.6s ease-in-out infinite;
  }

  @keyframes hero-drip {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (max-width: 800px) {
    .hero__content {
      padding: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
    }
  }
</style>
